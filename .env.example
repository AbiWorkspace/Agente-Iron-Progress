# Copia este archivo a .env y rellena los valores. El .env NO se versiona.

# --- WhatsApp Cloud API (Meta) ---
# Token que declaras en Meta al configurar el webhook (te lo devuelve en el GET).
VERIFY_TOKEN=
# Token de acceso permanente de la app de WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono emisor (Meta > WhatsApp > API Setup).
PHONE_NUMBER_ID=
# App Secret de la app de Meta. Habilita la validación de firma del webhook
# (X-Hub-Signature-256). Si se deja vacío, el webhook acepta CUALQUIER petición.
META_APP_SECRET=
# Versión del Graph API. Por defecto v21.0 si no se define.
GRAPH_VERSION=v21.0

# --- Entorno ---
# 'prod' arranca uvicorn SIN reload (imprescindible: con reload hay dos procesos
# y el APScheduler manda el readiness matutino duplicado a cada atleta).
ENTORNO=prod

# Puerto del servidor. Por defecto 8000.
PORT=8000

# --- Rutas opcionales (tienen valor por defecto; normalmente NO hace falta tocarlas) ---
# Base de telemetría que lee el motor predictivo.
# IRON_DB=data/iron_progress_telemetria.db
# Carpeta temporal donde se generan los PNG de las gráficas de progreso.
# IRON_TMP=/tmp/iron_graficas
